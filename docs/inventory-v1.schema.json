{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "sarevocs-ccu-inventory"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "dataMode": {
      "type": "string",
      "enum": [
        "demo",
        "real"
      ]
    },
    "account": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "identityKind": {
          "type": "string",
          "enum": [
            "rsi-handle",
            "manual-reference"
          ]
        }
      },
      "required": [
        "reference",
        "identityKind"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "full-hangar",
            "partial"
          ]
        },
        "exportComplete": {
          "type": "boolean"
        },
        "expectedPledges": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000
            },
            {
              "type": "null"
            }
          ]
        },
        "pagesExpected": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "pagesRead": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "exportComplete",
        "expectedPledges",
        "pagesExpected",
        "pagesRead"
      ],
      "additionalProperties": false
    },
    "pledges": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pledgeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "insurance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "lti"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "months"
                  },
                  "months": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1200
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "months",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "originalDescription": {
            "type": "string",
            "maxLength": 4000
          },
          "ships": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "childId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "modelName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "modelId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "identity": {
                  "type": "string",
                  "enum": [
                    "unresolved",
                    "confirmed"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "upgradeable",
                    "included",
                    "loaner",
                    "unverified"
                  ]
                }
              },
              "required": [
                "childId",
                "modelName",
                "modelId",
                "identity",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "ccus": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instanceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "unused",
                    "applied",
                    "unverified"
                  ]
                },
                "applicability": {
                  "type": "string",
                  "enum": [
                    "confirmed",
                    "unverified",
                    "rejected"
                  ]
                },
                "insurance": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "lti"
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "kind",
                        "evidence"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "months"
                        },
                        "months": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1200
                        },
                        "evidence": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "kind",
                        "months",
                        "evidence"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "unknown"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "kind",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "instanceId",
                "from",
                "to",
                "status",
                "applicability",
                "insurance"
              ],
              "additionalProperties": false
            }
          },
          "protected": {
            "type": "boolean"
          },
          "baseReleased": {
            "type": "boolean"
          },
          "restrictions": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "acquisitionCost": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USD",
                      "EUR"
                    ]
                  },
                  "taxBasis": {
                    "type": "string",
                    "enum": [
                      "net",
                      "gross",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "minor",
                  "currency",
                  "taxBasis",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "unknownCostReason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "meltValue": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USD",
                      "EUR"
                    ]
                  },
                  "taxBasis": {
                    "type": "string",
                    "enum": [
                      "net",
                      "gross",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "minor",
                  "currency",
                  "taxBasis",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceValues": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "required": [
          "pledgeId",
          "name",
          "insurance",
          "originalDescription",
          "ships",
          "ccus",
          "protected",
          "baseReleased",
          "restrictions",
          "acquisitionCost",
          "unknownCostReason",
          "meltValue",
          "sourceValues"
        ],
        "additionalProperties": false
      }
    },
    "buybacks": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "currentPrice": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "USD",
                      "EUR"
                    ]
                  },
                  "taxBasis": {
                    "type": "string",
                    "enum": [
                      "net",
                      "gross",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "minor",
                  "currency",
                  "taxBasis",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "const": "unverified"
          }
        },
        "required": [
          "entryId",
          "name",
          "description",
          "currentPrice",
          "availability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "schemaVersion",
    "appVersion",
    "createdAt",
    "dataMode",
    "account",
    "scope",
    "pledges",
    "buybacks"
  ],
  "additionalProperties": false
}
