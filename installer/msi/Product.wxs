<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="Sarevoc´s CCU Planer"
           Codepage="65001" Manufacturer="Sarevoc" Language="1031" Version="0.3.128" UpgradeCode="{6458FCD5-BD95-42AB-86D7-9C136FA4439D}">
    <Package SummaryCodepage="1252" Description="Sarevocs CCU Planer" Comments="Sarevocs CCU Planer 0.3.128" InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64"/>
    <MajorUpgrade Schedule="afterInstallFinalize" MigrateFeatures="no"
                  DowngradeErrorMessage="Eine neuere Version des CCU-Planers ist bereits installiert."/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip"/>
    <Property Id="CCUINSTALLDIR" Secure="yes"/>
    <Property Id="CCUACCEPTTERMS" Secure="yes"/>
    <Property Id="CCUUIREQUESTED" Secure="yes"/>
    <Property Id="CCUFOLDERRISKROOT" Secure="yes" Hidden="yes"/>
    <Property Id="REINSTALLMODE" Value="amus"/>
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <Icon Id="Planner.ico" SourceFile="$(var.MsiSources)\..\..\assets\app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="Planner.ico"/>
    <Condition Message="Diese Installation benötigt ein 64-Bit-Windows mit aktivierter Rücksicherung.">VersionNT64 AND NOT ALLUSERS AND NOT RollbackDisabled AND NOT DISABLEROLLBACK</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder"><Directory Id="CcuRoot" Name="CCU_Planer"/></Directory>
      <Directory Id="CcuLegacyRoot" Name="."/>
      <Directory Id="DesktopFolder"/>
      <Directory Id="ProgramMenuFolder"><Directory Id="CcuMenu" Name="Sarevoc"/></Directory>
    </Directory>
    <DirectoryRef Id="CcuRoot">
      <Component Id="Registration" Guid="{AA062386-A52E-471C-A74B-CB0E59306D7F}" Win64="yes">
        <RegistryValue Root="HKCU" Key="Software\Sarevoc\SarevocsCCUPlanerMSI" Name="InstallLocation" Type="string" Value="[CcuNormalizedRoot]" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\Sarevoc\SarevocsCCUPlanerMSI" Name="TermsAcceptance" Type="string" Value="2026-11-18.2:5438e49d354058b32007d2ed20e189391af6a96150bd9fa7ced6b3823c0e2e73"/>
        <Shortcut Id="PlannerDesktop" Directory="DesktopFolder" Name="Sarevoc´s CCU Planer Alpha" Target="[CcuRoot]Sarevocs-CCU-Planer.exe" WorkingDirectory="CcuRoot" Icon="Planner.ico" Advertise="no"/>
        <Shortcut Id="PlannerStart" Directory="CcuMenu" Name="Sarevoc´s CCU Planer Alpha" Target="[CcuRoot]Sarevocs-CCU-Planer.exe" WorkingDirectory="CcuRoot" Icon="Planner.ico" Advertise="no"/>
        <RemoveFolder Id="RemoveEmptyMenu" Directory="CcuMenu" On="uninstall"/>
      </Component>
      <Component Id="CabMigration" Guid="{D325872A-DD47-4EC2-87CB-55A323A1B2D9}" Win64="yes">
        <Condition>CcuLegacy = "1"</Condition>
        <RegistryValue Root="HKCU" Key="Software\Sarevoc\SarevocsCCUPlanerMSI" Name="MigratedCabVersion" Type="string" Value="[CcuLegacyVersion]" KeyPath="yes"/>
        <RemoveRegistryValue Id="RemoveCabInstallLocation" Root="HKCU" Key="Software\Sarevoc\SarevocsCCUPlaner" Name="InstallLocation"/>
        <RemoveRegistryValue Id="RemoveCabTermsAcceptance" Root="HKCU" Key="Software\Sarevoc\SarevocsCCUPlaner" Name="TermsAcceptance"/>
        <RemoveRegistryKey Id="RemoveExactCabArp" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\SarevocsCCUPlaner.Selectable" Action="removeOnInstall"/>
        <RemoveFile Id="OldDesktop" Directory="DesktopFolder" Name="Sarevoc´s CCU Planer.lnk" On="install"/>
        <RemoveFile Id="OldMenu" Directory="CcuMenu" Name="Sarevoc´s CCU Planer.lnk" On="install"/>
      </Component>
    </DirectoryRef>
    <Feature Id="Planner" Title="CCU Planer" Level="1" Absent="disallow" AllowAdvertise="no">
      <ComponentGroupRef Id="Payload"/>
      <ComponentRef Id="Registration"/>
      <ComponentRef Id="CabMigration"/>
      <ComponentGroupRef Id="LegacyFiles"/>
    </Feature>
    <Binary Id="PreflightCA" SourceFile="$(var.BuildDir)\Preflight.CA.dll"/>
    <CustomAction Id="ResolveCcuRoot" BinaryKey="PreflightCA" DllEntry="ResolveCcuRoot" Execute="immediate" Return="check"/>
    <CustomAction Id="VerifyCcuOwnership" BinaryKey="PreflightCA" DllEntry="VerifyCcuOwnership" Execute="immediate" Return="check"/>
    <CustomAction Id="PrepareCcuUi" BinaryKey="PreflightCA" DllEntry="PrepareCcuUi" Execute="immediate" Return="check"/>
    <CustomAction Id="CheckCcuPlanner" BinaryKey="PreflightCA" DllEntry="CheckCcuPlanner" Execute="immediate" Return="check"/>
    <UIRef Id="CcuSetupUI"/>
    <InstallUISequence>
      <Custom Action="PrepareCcuUi" Before="CostInitialize">NOT Installed AND UILevel = 5</Custom>
      <Show Dialog="CcuSetupDlg" Before="ProgressDlg">NOT Installed AND UILevel = 5</Show>
      <Show Dialog="CcuMaintenanceDlg" After="CcuSetupDlg">Installed AND NOT RESUME AND NOT Preselected AND UILevel = 5 AND NOT REMOVE AND NOT REINSTALL</Show>
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="ResolveCcuRoot" Before="CostInitialize">1</Custom>
      <Custom Action="VerifyCcuOwnership" Before="InstallValidate">1</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
